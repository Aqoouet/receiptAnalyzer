{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Receipt Analyzer (save emails)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/receiptAnalyzer/cmd",
            "env": {
                "CGO_ENABLED": "0"
            },
            "args": [
                "-save_new_emails",
            ],
            "args": [
                "-quantityToProcess",
                "10"
            ]
        }
    ]
}